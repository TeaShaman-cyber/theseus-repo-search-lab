#!/bin/sh
# Full, deliberately small legacy import closure; independent LeanDepViz oracle.
set -eu
ROOT=$(git rev-parse --show-toplevel)
LEAN_BIN_DIR=${LEAN_BIN_DIR:?set exact pinned Lean toolchain}
EXTRACTOR_MAIN=${EXTRACTOR_MAIN:?set verified adapted LeanDepViz source}
LEAN="$LEAN_BIN_DIR/lean"
"$LEAN" --version | grep -F 'commit 611c117bfaf7b7ae1cfcf246ce6fba31e8f509e9'
export PATH="$LEAN_BIN_DIR:$PATH"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT HUP INT TERM
cd "$WORK"
export LEAN_PATH="$WORK"
cat > Base.lean <<'EOF'
prelude
axiom P : Prop
axiom p : P
axiom q : P
EOF
cat > Left.lean <<'EOF'
prelude
import Base
theorem shared : P := p
theorem left : P := shared
EOF
cat > Right.lean <<'EOF'
prelude
import Base
theorem shared : P := q
theorem right : P := shared
EOF
cat > RightSame.lean <<'EOF'
prelude
import Base
theorem shared : P := p
theorem rightSame : P := shared
EOF
for pair in 'Root Left Right' 'Reverse Right Left' 'Agree Left RightSame' 'AgreeReverse RightSame Left'; do
    set -- $pair
    printf 'prelude\nimport %s\nimport %s\n' "$2" "$3" > "$1.lean"
done
for module in Base Left Right RightSame Root Reverse Agree AgreeReverse; do
    "$LEAN" -o "$module.olean" "$module.lean"
    env -u LEAN_PATH "$LEAN" --run "$ROOT/producer/lean/ReadModuleFacts.lean" "$module" "$WORK/$module.olean" --metadata "$module.json" > "$module.jsonl"
done
for module in Root Reverse Agree AgreeReverse; do
    "$LEAN" --run "$EXTRACTOR_MAIN" --roots "$module" --include-prefix Base,Left,Right,RightSame,Root,Reverse,Agree,AgreeReverse --json-out "$module-graph.json"
done
env -u LEAN_PATH "$LEAN" --run "$ROOT/producer/lean/ReadModuleFacts.lean" --resolve-theorem shared Left Left.olean Right Right.olean > resolution.json
PYTHONPATH="$ROOT:$ROOT/src" python3 - <<'PY'
import json
from pathlib import Path
from scripts.direct_module_replay import replay_closed_modules
from theseus_repo_search.normalize import normalize_leandepviz

resolution = json.loads(Path('resolution.json').read_text())
assert resolution['schema'] == 'theseus.lean-theorem-resolution.v1'
assert resolution['previous']['module'] == 'Left'
assert resolution['selected']['module'] == 'Right'
assert resolution['previous']['value_dependencies'] == ['p']
assert resolution['selected']['value_dependencies'] == ['q']

def inputs(modules):
    return [(json.loads(Path(m+'.json').read_text()),
             [json.loads(l) for l in Path(m+'.jsonl').read_text().splitlines()]) for m in modules]

for root, expected in [('Agree', ['Left', 'RightSame']), ('AgreeReverse', ['RightSame', 'Left'])]:
    modules = ['Base', 'Left', 'RightSame', root]
    result = replay_closed_modules(inputs(modules), [root])
    control = json.loads(Path(root+'-graph.json').read_text())
    kwargs = dict(source_commit='synthetic-closure', root_modules=tuple(modules), producer_ref='comparison')
    actual = normalize_leandepviz(result.graph, **kwargs)
    assert actual == normalize_leandepviz(control, **kwargs)
    assert (len(actual[0]), len(actual[1])) == (6, 8)
    assert result.module_order == ['Base', *expected, root]
    assert result.occurrences['shared'] == expected

for root, owner, dep in [('Root', 'Left', 'q'), ('Reverse', 'Right', 'p')]:
    control = json.loads(Path(root+'-graph.json').read_text())
    assert next(n['module'] for n in control['nodes'] if n['name']=='shared') == owner
    assert {e['source'] for e in control['edges'] if e['target']=='shared' and e['kind']=='value'} == {dep}
    try:
        replay_closed_modules(inputs(['Base', 'Left', 'Right', root]), [root])
    except ValueError as error:
        assert str(error) == 'conflicting observed dependency signatures: shared'
    else:
        raise AssertionError('conflicting proof dependencies accepted')
print('CLOSED_MODULE_GRAPH_CONTROL_PASS')
PY

mkdir split
for module in Base Left Right Root Reverse; do
    { printf 'module\n'; sed -e 's/^axiom /public axiom /' -e 's/^theorem /public theorem /' -e 's/^import /public import /' "$module.lean"; } > "split/$module.lean"
done
# The private-root oracle includes non-exported imports too.
sed -i 's/^public import Left$/import Left/' split/Root.lean
cd split
export LEAN_PATH="$PWD"
for module in Base Left Right Root Reverse; do
    "$LEAN" -o "$module.olean" "$module.lean"
    env -u LEAN_PATH "$LEAN" --run "$ROOT/producer/lean/ReadModuleFacts.lean" "$module" "$PWD/$module.olean" --metadata "$module.json" > "$module.jsonl"
done
for module in Root Reverse; do
    "$LEAN" --run "$EXTRACTOR_MAIN" --roots "$module" --include-prefix Base,Left,Right,Root,Reverse --json-out "$module-graph.json"
done
cat > Different.lean <<'EOF'
module
prelude
public axiom Q : Prop
public axiom qProof : Q
public theorem shared : Q := qProof
EOF
"$LEAN" -o Different.olean Different.lean
if env -u LEAN_PATH "$LEAN" --run "$ROOT/producer/lean/ReadModuleFacts.lean" --resolve-theorem shared Left Left.olean Different Different.olean > rejected.json 2> rejected.err; then
    echo 'incompatible theorem accepted' >&2; exit 1
fi
grep -F 'theorem subsumption not established' rejected.err
test ! -s rejected.json
PYTHONPATH="$ROOT:$ROOT/src" python3 - "$LEAN" "$ROOT" <<'PY'
import copy
import json
import sys
from pathlib import Path
from scripts.direct_module_replay import replay_closed_modules, theorem_verifier
from theseus_repo_search.normalize import normalize_leandepviz

for root, owner, selected in [('Root', 'Left', 'Right'), ('Reverse', 'Right', 'Left')]:
    modules = ['Base', 'Left', 'Right', root]
    inputs = [(json.loads(Path(m+'.json').read_text()),
               [json.loads(l) for l in Path(m+'.jsonl').read_text().splitlines()]) for m in modules]
    assert all(meta['is_module'] and meta['ir_extra_const_names'] == [] for meta, _ in inputs)
    verify = theorem_verifier([sys.argv[1], '--run', sys.argv[2]+'/producer/lean/ReadModuleFacts.lean'],
                              {m: Path(m+'.olean') for m in modules})
    result = replay_closed_modules(inputs, [root], private_split=True, verify_theorem=verify)
    kwargs = dict(source_commit='synthetic-split', root_modules=tuple(modules), producer_ref='comparison')
    actual = normalize_leandepviz(result.graph, **kwargs)
    oracle = normalize_leandepviz(json.loads(Path(root+'-graph.json').read_text()), **kwargs)
    assert actual == oracle
    assert (len(actual[0]), len(actual[1])) == (6, 8)
    assert result.occurrences['shared'] == [owner, selected]
    assert result.selected_modules['shared'] == selected
    corrupted = copy.deepcopy(inputs)
    next(row for row in corrupted[1][1] if row['full_name']=='shared')['value_dependencies'] = ['q']
    try:
        replay_closed_modules(corrupted, [root], private_split=True, verify_theorem=verify)
    except ValueError as error:
        assert str(error) == 'theorem resolution does not bind supplied facts'
    else:
        raise AssertionError('unbound resolution accepted')
print('SPLIT_CLOSURE_EXACT_REPLAY_PASS')
PY

# Real, complete pinned standard-library closure. No Mathlib download or build.
mkdir "$WORK/stdlib"
cd "$WORK/stdlib"
PYTHONPATH="$ROOT:$ROOT/src" python3 - "$LEAN" "$ROOT" "$EXTRACTOR_MAIN" <<'PY'
import collections
import json
import os
import subprocess
import sys
from pathlib import Path
from scripts.direct_module_replay import replay_closed_modules, theorem_verifier
from theseus_repo_search.normalize import normalize_leandepviz

lean, repo, extractor = sys.argv[1:]
lib = Path(lean).resolve().parent.parent / 'lib/lean'
command = [lean, '--run', repo+'/producer/lean/ReadModuleFacts.lean']
env = os.environ.copy()
env.pop('LEAN_PATH', None)
root = 'Init.Data.Nat.Basic'
todo = [root]
inputs = {}
files = {}
while todo:
    module = todo.pop()
    if module in inputs:
        continue
    assert len(inputs) < 80, 'unexpectedly large standard library closure'
    path = lib / Path(*module.split('.')).with_suffix('.olean')
    files[module] = path
    metadata = Path(module+'.json')
    facts = subprocess.check_output([*command, module, str(path), '--metadata', str(metadata)], env=env, text=True, timeout=30)
    meta = json.loads(metadata.read_text())
    inputs[module] = (meta, [json.loads(line) for line in facts.splitlines()])
    todo.extend(i['module'] for i in meta['imports'])
result = replay_closed_modules(inputs.values(), [root], private_split=True,
                               verify_theorem=theorem_verifier(command, files))
subprocess.run([lean, '--run', extractor, '--roots', root, '--include-prefix', 'Init',
                '--json-out', 'oracle.json'], env=env, check=True, timeout=90)
kwargs = dict(source_commit='lean436', root_modules=tuple(inputs), producer_ref='comparison')
actual = normalize_leandepviz(result.graph, **kwargs)
assert actual == normalize_leandepviz(json.loads(Path('oracle.json').read_text()), **kwargs)
assert (len(inputs), len(actual[0]), len(actual[1])) == (13, 4184, 35534)
assert collections.Counter(x[3] for x in result.omitted_dependencies) == {'internal': 587}
assert any(meta['quoted_short_names'] for meta, _ in inputs.values())
assert any(meta['ir_extra_const_names'] for meta, _ in inputs.values())
print('REAL_NAT_CLOSURE_CONTROL_PASS')
PY

# Reuse a single external name inventory for a terminal root, not its proof bodies.
"$LEAN" --run "$ROOT/producer/lean/ReadDependencyNames.lean" Init.SimpLemmas Init.Data.NeZero Init.Grind.Tactics > dependency-names.jsonl
PYTHONPATH="$ROOT:$ROOT/src" python3 - "$LEAN" "$ROOT" <<'PY'
import json
import os
import subprocess
import sys
from pathlib import Path
from scripts.direct_module_replay import load_dependency_inventory, replay_closed_modules
from theseus_repo_search.normalize import normalize_leandepviz
lean, repo = sys.argv[1:]
root = 'Init.Data.Nat.Basic'
lib = Path(lean).resolve().parent.parent / 'lib/lean'
env = os.environ.copy()
env.pop('LEAN_PATH', None)
path = lib / Path(*root.split('.')).with_suffix('.olean')
facts = subprocess.check_output([lean, '--run', repo+'/producer/lean/ReadModuleFacts.lean', root, str(path), '--metadata', 'terminal.json'], env=env, text=True, timeout=30)
meta = json.loads(Path('terminal.json').read_text())
with Path('dependency-names.jsonl').open() as stream:
    inventory = load_dependency_inventory(map(json.loads, stream))
result = replay_closed_modules([(meta, list(map(json.loads, facts.splitlines())))], [root], private_split=True, dependency_inventory=inventory)
kwargs = dict(source_commit='lean436', root_modules=(root,), producer_ref='comparison')
actual = normalize_leandepviz(result.graph, **kwargs)
assert actual == normalize_leandepviz(json.loads(Path('oracle.json').read_text()), **kwargs)
assert (len(inventory.module_order), len(inventory.names), len(actual[0]), len(actual[1])) == (12, 10954, 330, 398)
assert any(x[3] == 'external_kernel' for x in result.omitted_dependencies)
print('REAL_DEPENDENCY_INVENTORY_PASS')
PY
