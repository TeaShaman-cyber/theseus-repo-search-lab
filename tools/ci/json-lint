#!/bin/sh
# Strict decoded-key validation plus the existing Biome profile over tracked JSON.
set -eu
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" python3 scripts/check_json_contract.py
test "$(biome --version)" = 'Version: 2.6.6'
paths=$(mktemp)
trap 'rm -f "$paths"' EXIT
git ls-files -z -- '*.json' > "$paths"
test -s "$paths"
xargs -0 biome lint --config-path biome.json --diagnostic-level=warn --error-on-warnings < "$paths"
